{
  "name": "bb-plugin-pi-gateways",
  "version": "0.3.0",
  "type": "module",
  "description": "Google AI Studio, TokenRouter, OpenRouter, NVIDIA Build, OpenCode Zen, Kilo Code, and custom model endpoints inside bb through pi.",
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/ts-resolver.mjs --test tests/*.test.ts"
  },
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Pi Gateways",
    "description": "Adds Google AI Studio, TokenRouter, OpenRouter, NVIDIA Build, OpenCode Zen, Kilo Code, and custom endpoints to pi over HTTP APIs.",
    "branding": {
      "icon": "./icons/gateway.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "typescript": "^5.7.0"
  }
}
