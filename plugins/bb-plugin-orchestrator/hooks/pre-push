#!/usr/bin/env node
/**
 * Shared git pre-push hook for the bb orchestrator release pipeline
 * (spec orchestrator-release §5). Installed once per development user via
 * global `core.hooksPath` — ordinary `git push` is refused unless the
 * plugin's `release` command left a one-time token for the pushed
 * branch+commit in `<hooks dir>/push-token-<id>.json` (one file per
 * release run — §16.6, parallel releases don't clobber each other). After
 * its own checks the hook chains to the repository's local
 * `$GIT_DIR/hooks/pre-push` when it exists.
 *
 * Repo skips: `exclusions` (one absolute repo path or dir-prefix per
 * line, `#` comments) next to this script — for service repositories
 * with their own autopush. A repo with a *local* `core.hooksPath` never
 * reaches this script at all (local config wins over the global one).
 */
import { existsSync, readFileSync, readdirSync, rmSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const HOOK_NAME = "pre-push";
const dir = dirname(fileURLToPath(import.meta.url));
const exclusionsFile = join(dir, "exclusions");
const ZERO = "0000000000000000000000000000000000000000";

const stdin = readFileSync(0, "utf8");

function git(args) {
  return spawnSync("git", args, { encoding: "utf8" });
}

/** The repository's own hook (the global core.hooksPath shadows it):
 * `$GIT_DIR/hooks/<name>` — the env var first, then the common dir for
 * worktrees. */
function localHookPath() {
  const candidates = [];
  if (process.env.GIT_DIR) {
    candidates.push(join(resolve(process.env.GIT_DIR), "hooks", HOOK_NAME));
  }
  const common = git(["rev-parse", "--git-common-dir"]);
  if (common.status === 0) {
    candidates.push(join(common.stdout.trim(), "hooks", HOOK_NAME));
  }
  const self = fileURLToPath(import.meta.url);
  for (const c of candidates) {
    if (c !== self && existsSync(c)) return c;
  }
  return null;
}

function chainLocal() {
  const local = localHookPath();
  if (!local) return 0;
  const res = spawnSync(local, process.argv.slice(2), {
    input: stdin,
    encoding: "utf8",
    stdio: ["pipe", "inherit", "inherit"],
  });
  return res.status ?? 1;
}

function refuse(msg) {
  process.stderr.write(`[orchestrator] ${msg}\n`);
  process.exit(1);
}

// ── Exclusions: service repositories with their own push flow. ────────
const repoTop = git(["rev-parse", "--show-toplevel"]);
if (repoTop.status === 0) {
  const repo = repoTop.stdout.trim();
  let excluded = false;
  try {
    for (const line of readFileSync(exclusionsFile, "utf8").split("\n")) {
      const e = line.trim();
      if (!e || e.startsWith("#")) continue;
      if (e.endsWith("/")) {
        if (repo.startsWith(e)) { excluded = true; break; }
      } else if (repo === e) { excluded = true; break; }
    }
  } catch { /* no exclusions file — nothing excluded */ }
  if (excluded) process.exit(chainLocal());
}

// ── Ref lines from stdin: <local ref> <local sha> <remote ref> <remote sha>.
const refs = stdin
  .split("\n")
  .map((l) => l.trim())
  .filter(Boolean)
  .map((l) => l.split(/\s+/));
const pushed = refs
  .map((r) => ({ sha: r[1], remote: r[2] ?? "" }))
  .filter((r) => r.sha && r.sha !== ZERO);

// Branch/tag deletions cannot publish code — let them through.
if (pushed.length === 0) process.exit(chainLocal());

// §16.6: one token file per release run — `push-token-<id>.json`.
// A token binds the remote branch AND the sha; a token without a
// `branch` field is never valid (PLUG-191: the sha-only legacy
// `push-token.json` had no writer left and only weakened the branch
// binding). The branch is compared to the FULL pushed ref
// (`refs/heads/<branch>`) — a tag can never satisfy a branch token.
const tokenFiles = readdirSync(dir).filter((f) =>
  /^push-token(?:-.+)?\.json$/.test(f),
);

const consumed = [];
for (const p of pushed) {
  let match = null;
  let sawSha = false;
  let sawBranch = false;
  let sawExpired = false;
  for (const f of tokenFiles) {
    if (consumed.includes(f)) continue; // a marker is one-time — one ref each
    let t;
    try {
      t = JSON.parse(readFileSync(join(dir, f), "utf8"));
    } catch {
      continue;
    }
    if (
      !t ||
      typeof t.token !== "string" ||
      typeof t.sha !== "string" ||
      typeof t.branch !== "string" ||
      typeof t.expiresAt !== "number"
    ) {
      continue;
    }
    if (t.sha !== p.sha) continue;
    sawSha = true;
    if (`refs/heads/${t.branch}` !== p.remote) {
      sawBranch = true;
      continue;
    }
    if (t.expiresAt < Date.now()) {
      sawExpired = true;
      try { rmSync(join(dir, f)); } catch { /* stale */ }
      continue;
    }
    match = f;
    break;
  }
  if (!match) {
    if (sawExpired) {
      refuse(
        "push отклонён: маркер release истёк — повторите `bb orchestrator release`",
      );
    } else if (sawSha && sawBranch) {
      refuse(
        `push отклонён: маркер release выписан на другую ветку ` +
          `(${p.remote} ≠ ветка маркера)`,
      );
    } else if (tokenFiles.length) {
      refuse(
        `push отклонён: маркер release выписан на другой коммит ` +
          `(${p.sha.slice(0, 8)})`,
      );
    } else {
      refuse(
        "push отклонён: выкладка только через `bb orchestrator release` " +
          "(нет одноразового маркера)",
      );
    }
  }
  consumed.push(match);
}
// One-time markers — consumed before chaining to the repo's local hook.
for (const f of consumed) {
  try { rmSync(join(dir, f)); } catch { /* gone */ }
}
process.exit(chainLocal());
