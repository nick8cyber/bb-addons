#!/usr/bin/env node
// Generic shared-hook wrapper (spec orchestrator §17.3, §24.1).
// The shared `core.hooksPath` shadows EVERY standard hook name, so the
// installer copies this file under each of them — else a repository's
// local hook would silently stop firing.
//
// Behaviour: run the previous hook for my name with the same arguments
// and stdin — a migrated local `core.hooksPath` of this copy
// (`chain.json`), then the repository's own `$GIT_DIR/hooks/<name>`,
// then the previous global `core.hooksPath` — only when it is
// executable, exactly like git (`hook-lib.mjs`, `chainTarget`).
import { spawnSync } from "node:child_process";
import { dirname, basename } from "node:path";
import { fileURLToPath } from "node:url";

const self = fileURLToPath(import.meta.url);
const dir = dirname(self);
const name = basename(self);

let lib;
try {
  lib = await import("./hook-lib.mjs");
} catch {
  process.exit(0); // an incomplete install must not wedge git
}
const target = lib.chainTarget(dir, name, self);
if (!target) process.exit(0);
const res = spawnSync(target, process.argv.slice(2), { stdio: "inherit" });
process.exit(res.error ? 1 : (res.status ?? 1));
