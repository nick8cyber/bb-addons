#!/usr/bin/env node
/**
 * Generic shared-hook wrapper (spec orchestrator §17.3, Б2). The shared
 * `core.hooksPath` shadows EVERY standard hook name, so install.mjs
 * copies this file under each of them — else a repo's local `pre-commit`
 * or `commit-msg` would silently stop firing.
 *
 * Behaviour: resolve the repository's own `$GIT_DIR/hooks/<my name>`
 * (GIT_DIR first, then `--git-common-dir` for worktrees) and exec it
 * with the same arguments; stdin/stdout/stderr are inherited, the exit
 * code passes through. No local hook — exit 0. The orchestrator's own
 * gate lives only in `pre-push`; this wrapper never decides.
 */
import { existsSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const self = fileURLToPath(import.meta.url);
const HOOK_NAME = basename(process.argv[1] ?? self);

function git(args) {
  return spawnSync("git", args, { encoding: "utf8" });
}

function localHookPath() {
  const candidates = [];
  if (process.env.GIT_DIR) {
    candidates.push(join(resolve(process.env.GIT_DIR), "hooks", HOOK_NAME));
  }
  const common = git(["rev-parse", "--git-common-dir"]);
  if (common.status === 0) {
    candidates.push(join(common.stdout.trim(), "hooks", HOOK_NAME));
  }
  for (const c of candidates) {
    if (c !== self && existsSync(c)) return c;
  }
  return null;
}

const local = localHookPath();
if (!local) process.exit(0);
// stdio "inherit" pipes git's stdin through unchanged — hook kinds that
// read ref lines (post-rewrite, …) see exactly what git sent.
const res = spawnSync(local, process.argv.slice(2), { stdio: "inherit" });
if (res.error) {
  process.stderr.write(`[orchestrator] local ${HOOK_NAME}: ${res.error.message}\n`);
  process.exit(1);
}
process.exit(res.status ?? (res.signal ? 1 : 0));
