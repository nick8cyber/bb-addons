{
  "name": "bb-plugin-live-call",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Голосовой звонок с координатором BB через Gemini Live API: браузер даёт микрофон и динамик, ключи и инструменты живут на сервере",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Live Call",
    "description": "Голосовые звонки с координатором BB через Gemini Live API",
    "branding": {
      "icon": "Phone"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "react-dom": "^19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
